// Runs on every boot where a 0x83 partition mounts, from main.c PHASE 7:
//     codefs_mount(i) ... else if (ext2_mount(i))
//         script_run_file("/scripts/test1.script");
//         script_run_file("/scripts/complex.script");
// These two paths are hardcoded there, so the pre-baked disk.img has to ship
// them or the mount succeeds and then silently finds nothing to run.

print "CodeOS Scripting Engine Test"

let counter = 0
while counter < 5 {
    print "Count: " + counter
    let counter = counter + 1
}
